# Copy to .env and adjust as needed. No secrets are required for local dev.

# Postgres (docker-compose.yml reads these; defaults shown)
POSTGRES_USER=ntwv
POSTGRES_PASSWORD=ntwv_dev_password
POSTGRES_DB=ntwv
POSTGRES_PORT=5432

# App
DATABASE_URL=postgresql://ntwv:ntwv_dev_password@localhost:5432/ntwv
NEXT_PUBLIC_SITE_URL=http://localhost:3000

